# OpenCode Go API key: https://opencode.ai/docs/go/
OPENCODE_API_KEY=

# Self-hosted OpenAI-compatible Qwen endpoint.
QWEN_API_KEY=
QWEN_BASE_URL=https://casinos-maintains-comfort-redhead.trycloudflare.com/v1
QWEN_CONTEXT_WINDOW_TOKENS=32768

# Private PaddleOCR-VL service (demo ThinkPad over Tailscale). http only;
# loopback, RFC 1918, or 100.64.0.0/10 hosts.
PADDLE_OCR_BASE_URL=http://100.90.16.40:8080

# Supabase chat persistence. The secret key is server-only; never expose it to clients.
SUPABASE_URL=
SUPABASE_SECRET_KEY=

# Standalone WhatsApp adapter. Start it separately with `bun run dev:whatsapp`.
ANCHOR_WHATSAPP_ALLOWED_SENDER=917028546994
ANCHOR_WHATSAPP_RECEIVING_NUMBER=917276411669
ANCHOR_WHATSAPP_AUTH_DIR=./auth_info_baileys
# Optional override. By default the adapter discovers the Eve process started by Next.js.
ANCHOR_WHATSAPP_EVE_SOCKET_URL=
DEEPGRAM_API_KEY=
CARTESIA_API_KEY=
CARTESIA_VOICE_ID=
